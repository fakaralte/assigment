<%- include('../partials/header') %>

<h1 class="text-xl font-bold mb-4">Classrooms</h1>

<form action="/timetable/classrooms" method="POST" class="grid grid-cols-3 gap-3 mb-6 bg-white p-4 rounded shadow">
  <input type="text" name="name" placeholder="Room Name" required class="border p-2 rounded">
  <select name="type" class="border p-2 rounded">
    <option value="lecture">Lecture Hall</option>
    <option value="lab">Lab</option>
  </select>
  <input type="number" name="capacity" placeholder="Capacity" required class="border p-2 rounded">
  <button type="submit" class="col-span-3 bg-blue-600 text-white py-2 rounded">Add Classroom</button>
</form>

<table class="w-full border-collapse bg-white rounded shadow">
  <thead>
    <tr class="bg-gray-100 text-left">
      <th class="p-2">Name</th><th class="p-2">Type</th><th class="p-2">Capacity</th><th class="p-2"></th>
    </tr>
  </thead>
  <tbody>
    <% classrooms.forEach(c => { %>
      <tr class="border-b">
        <td class="p-2"><%= c.name %></td>
        <td class="p-2"><%= c.type %></td>
        <td class="p-2"><%= c.capacity %></td>
        <td class="p-2">
          <form action="/timetable/classrooms/<%= c._id %>/delete" method="POST">
            <button class="text-red-600 text-sm">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>