<%- include('partials/header') %>

<h1 class="text-xl font-bold mb-4">Fee Heads</h1>

<form action="/assign-fee" method="POST" class="grid grid-cols-2 gap-3 mb-6 bg-white p-4 rounded shadow">
  <input type="text" name="name" placeholder="Fee Head Name (e.g. Tuition)" required class="border p-2 rounded">
  <input type="text" name="department" placeholder="Department" required class="border p-2 rounded">
  <input type="number" name="amount" placeholder="Amount" required class="border p-2 rounded">
  <input type="number" name="semester" placeholder="Semester" required class="border p-2 rounded">
  <button type="submit" class="col-span-2 bg-blue-600 text-white py-2 rounded">Add Fee Head</button>
</form>

<table class="w-full border-collapse bg-white rounded shadow">
  <thead>
    <tr class="bg-gray-100 text-left">
      <th class="p-2">Name</th><th class="p-2">Department</th><th class="p-2">Amount</th><th class="p-2">Semester</th>
    </tr>
  </thead>
  <tbody>
    <% feeHeads.forEach(f => { %>
      <tr class="border-b">
        <td class="p-2"><%= f.name %></td>
        <td class="p-2"><%= f.department %></td>
        <td class="p-2">₹<%= f.amount %></td>
        <td class="p-2"><%= f.semester %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('partials/footer') %>