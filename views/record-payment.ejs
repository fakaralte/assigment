<%- include('partials/header') %>

<h1 class="text-xl font-bold mb-4">Record Payment</h1>

<div class="bg-white p-4 rounded shadow mb-4">
  <p><strong>Student:</strong> <%= installment.feeAssignment.student.name %></p>
  <p><strong>Fee Head:</strong> <%= installment.feeAssignment.feeHead.name %></p>
  <p><strong>Installment Amount:</strong> ₹<%= installment.amount %></p>
</div>

<form action="/fees/pay/<%= installment._id %>" method="POST" class="grid grid-cols-2 gap-3 bg-white p-4 rounded shadow">
  <input type="number" name="amount" placeholder="Amount Paid" value="<%= installment.amount %>" required class="border p-2 rounded">
  <select name="method" required class="border p-2 rounded">
    <option value="cash">Cash</option>
    <option value="upi">UPI</option>
    <option value="card">Card</option>
    <option value="netbanking">Net Banking</option>
  </select>
  <input type="text" name="referenceId" placeholder="Reference / Transaction ID" required class="border p-2 rounded col-span-2">
  <button type="submit" class="col-span-2 bg-blue-600 text-white py-2 rounded">Confirm Payment</button>
</form>

<%- include('partials/footer') %>