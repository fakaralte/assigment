<%- include('../partials/header') %>

<h1 class="text-xl font-bold mb-4">Pending Correction Requests</h1>

<% if (requests.length === 0) { %>
  <p class="text-gray-500">No pending requests.</p>
<% } %>

<div class="space-y-3">
  <% requests.forEach(r => { %>
    <div class="border rounded p-4 flex justify-between items-center">
      <div>
        <p class="font-medium"><%= r.attendanceRecord.student.name %></p>
        <p class="text-sm text-gray-600"><%= r.oldStatus %> → <%= r.newStatus %> · <%= r.reason %></p>
        <p class="text-xs text-gray-400">Requested by <%= r.requestedBy.name %></p>
      </div>
      <div class="flex gap-2">
        <form action="/admin/corrections/<%= r._id %>/decide" method="POST">
          <input type="hidden" name="decision" value="approved">
          <button class="bg-green-600 text-white px-3 py-1 rounded text-sm">Approve</button>
        </form>
        <form action="/admin/corrections/<%= r._id %>/decide" method="POST">
          <input type="hidden" name="decision" value="rejected">
          <button class="bg-red-600 text-white px-3 py-1 rounded text-sm">Reject</button>
        </form>
      </div>
    </div>
  <% }) %>
</div>

<%- include('../partials/footer') %>