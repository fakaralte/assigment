<%- include('partials/header') %>

<h1 class="text-xl font-bold mb-4">Assign Fee to Student</h1>

<form action="/assign-fee" method="POST" class="grid grid-cols-2 gap-3 bg-white p-4 rounded shadow">
  <select name="student" required class="border p-2 rounded">
    <option value="">Select Student</option>
    <% students.forEach(s => { %>
      <option value="<%= s._id %>"><%= s.name %> (<%= s.rollNo %>)</option>
    <% }) %>
  </select>

  <select name="feeHead" required class="border p-2 rounded">
    <option value="">Select Fee Head</option>
    <% feeHeads.forEach(f => { %>
      <option value="<%= f._id %>"><%= f.name %> — ₹<%= f.amount %></option>
    <% }) %>
  </select>

  <input type="number" name="totalAmount" placeholder="Total Amount" required class="border p-2 rounded">
  <input type="number" name="discount" placeholder="Discount (optional)" class="border p-2 rounded">
  <input type="date" name="dueDate" required class="border p-2 rounded">
  <input type="number" name="installmentCount" placeholder="No. of Installments" value="1" min="1" required class="border p-2 rounded">

  <button type="submit" class="col-span-2 bg-blue-600 text-white py-2 rounded">Assign Fee</button>
</form>

<%- include('partials/footer') %>